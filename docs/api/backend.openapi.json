              "type": "string"
            },
            "maxItems": 5,
            "uniqueItems": true
          }
        },
        "required": [
          "requestId",
          "text"
        ]
      },
      "Accepted": {
        "type": "object",
        "properties": {
          "messageId": {
            "type": "string"
          }
        },
        "required": [
          "messageId"
        ]
      },
      "ChatEvent": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "chat.updated",
              "chats.updated"
            ]
          },
          "chatId": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "securitySchemes": {
      "profileCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "neti_session"
      },
      "guestToken": {
        "type": "http",
        "scheme": "bearer"
      },
      "guestWebSocket": {
        "type": "apiKey",
        "in": "header",
        "name": "Sec-WebSocket-Protocol"
      }
    }
