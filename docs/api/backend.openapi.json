            "maxLength": 64,
            "pattern": "^[a-z0-9-]+$"
          },
          "text": {
            "type": "string",
            "maxLength": 2000
          },
          "quote": {
            "type": "string",
            "maxLength": 1200
          },
          "fileIds": {
            "type": "array",
