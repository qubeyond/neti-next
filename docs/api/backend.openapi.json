          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16777216
          }
        },
        "required": [
          "id",
          "name",
          "mime",
          "size"
        ]
      },
      "Citation": {
        "type": "object",
