            "enum": [
              "light",
              "dark"
            ]
          },
          "instructions": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "theme",
          "instructions"
        ]
      },
      "ProfilePatch": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
