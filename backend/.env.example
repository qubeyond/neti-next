BACKEND_PORT=8000

# Путь к данным профилей, чатов и файлов. Образ использует /var/lib/neti/workspace.db.
# BACKEND_DATA_FILE=neti-data/workspace.db

# Локальный процесс по умолчанию использует loopback. Образ обращается к http://agent:8001.
# BACKEND_AGENT_URL=http://127.0.0.1:8001

# За TLS-прокси установите true для Secure cookie профиля.
BACKEND_SECURE_COOKIES=false
