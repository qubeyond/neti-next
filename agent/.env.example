# HTTP и инференс
WEB_ANSWERS_ENABLED=false
AGENT_TOKEN=
AGENT_TURN_TIMEOUT_SECONDS=95
AGENT_MAX_CONCURRENT=4
AGENT_VERIFY_ANSWERS=true
AGENT_AUDIT_MAX_TOKENS=160
AGENT_DECISION_ROUTING=true
AGENT_DECISION_TIMEOUT_SECONDS=4
INFERENCE_URL=http://127.0.0.1:8002
INFERENCE_TIMEOUT_SECONDS=90
INFERENCE_TOKEN=
AGENT_MAX_OUTPUT_TOKENS=1536

# Поиск
SEARCH_PROVIDER=exa
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=15
EXA_API_KEY=
FIRECRAWL_API_KEY=
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic

# Контекст
WEB_SOURCE_MAX_CHARS=1500
WEB_RECOVERY_READ=true
WEB_RECOVERY_SEARCH=true

# Поисковые API
EXA_SEARCH_URL=https://api.exa.ai/search
TAVILY_SEARCH_URL=https://api.tavily.com/search
FIRECRAWL_SEARCH_URL=https://api.firecrawl.dev/v2/search

# Exa
EXA_SEARCH_TYPE=auto
EXA_SEARCH_HIGHLIGHTS=true

# Дополнительный поиск
WEB_RECOVERY_PROVIDER=tavily
WEB_RECOVERY_MAX_NEW_SOURCES=2
WEB_RECOVERY_REASONING=false
WEB_REWRITE_MAX_TOKENS=400
WEB_REWRITE_MAX_TITLE_CHARS=240
WEB_REWRITE_MAX_QUERY_CHARS=300
WEB_REWRITE_REASONING=false

# Чтение Firecrawl
FIRECRAWL_SCRAPE_URL=https://api.firecrawl.dev/v2/scrape
FIRECRAWL_SCRAPE_TIMEOUT_MS=10000
FIRECRAWL_HTTP_TIMEOUT_SECONDS=12

# Кэш публичных документов
AGENT_CACHE_DSN=
AGENT_DOCUMENT_TTL_SECONDS=3600
AGENT_DOCUMENT_CACHE_CAPACITY=128
