# RouterAI
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
ROUTERAI_TIMEOUT_SECONDS=70

# Модели
LLM_MODEL=deepseek/deepseek-v4-flash
DECISION_MODEL=~typesafe/jev-latest
DECISION_TIMEOUT_SECONDS=3
INFERENCE_EXTRA_MODELS=
ASR_MODEL=openai/whisper-large-v3
ASR_LANGUAGE=ru
OCR_MODEL=google/gemini-3.1-flash-lite
OCR_MAX_TOKENS=2048
PDF_OCR_ENGINE=mistral-ocr
PDF_OCR_MAX_TOKENS=100

# Доступ и логирование
INFERENCE_TOKEN=
INFERENCE_LOG_LEVEL=INFO
INFERENCE_REQUEST_TIMEOUT_SECONDS=85

# Лимиты
INFERENCE_MAX_FILE_BYTES=16777216
INFERENCE_MAX_MESSAGES=32
INFERENCE_MAX_MESSAGE_CHARS=60000
INFERENCE_MAX_TOTAL_INPUT_CHARS=120000
INFERENCE_MAX_MODEL_CHARS=200
INFERENCE_MAX_OUTPUT_TOKENS=16384
INFERENCE_MAX_CONCURRENT=4
INFERENCE_ASR_MAX_CONCURRENT=2
INFERENCE_OCR_MAX_CONCURRENT=2
